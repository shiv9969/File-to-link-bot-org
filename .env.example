# Required Telegram credentials
API_ID=
API_HASH=
BOT_TOKEN=

# Required storage configuration
BIN_CHANNEL=
DATABASE_URL=

# Optional bot configuration
UPDATES_CHANNEL=None
OWNER_ID=
OWNER_USERNAME=
APP_NAME=
FQDN=
HAS_SSL=true
PORT=8080
WEB_SERVER_BIND_ADDRESS=0.0.0.0
SLEEP_THRESHOLD=60
WORKERS=4
PING_INTERVAL=1200

# Leave empty unless you intentionally want these channel rules.
# BANNED_CHANNELS makes the bot leave those channels.
BANNED_CHANNELS=
# BAN_CHNL keeps the bot in the channel but skips link generation.
BAN_CHNL=
